# The go-toolset image only provides dnf and the C toolchain here. The build
# uses the upstream Go release of go.mod installed below, which comes first in
# PATH, not the Red Hat Go of the image with its OpenSSL based FIPS crypto.

# Dependabot keeps the digest up to date.
FROM registry.access.redhat.com/ubi9/go-toolset@sha256:a3b89f072fe0704b9388f3c9ad5681a6cf16293324e3f25ca0107bc09217cf62 AS build
# Only the build stage runs as root, the final image does not.
# hadolint ignore=DL3002
USER root
WORKDIR /work
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN dnf install -y \
  libseccomp-devel \
  && dnf clean all

# Install the Go toolchain from the version go.mod targets, preferring its
# toolchain directive over the go directive (see hack/go-version.sh). Copying
# go.mod first keeps this layer cached until the project actually changes Go
# version.
# Resolving go.dev/VERSION here instead would be worse than it looks: this layer
# sits above the source COPY, so the "latest" it returns is frozen by the build
# cache at whatever it happened to be, leaving the shipped toolchain pinned to a
# version nobody chose and unrecorded in the provenance.
# The checksums are pinned per architecture and tracked next to the golang
# entry of dependencies.yaml, a Go bump in go.mod has to update them as well.
ARG GO_SHA256_amd64=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
ARG GO_SHA256_arm64=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49
COPY go.mod hack/go-version.sh /tmp/
RUN ARCH=$(arch | sed 's|x86_64|amd64|g' | sed 's|aarch64|arm64|g') && \
    GO_VERSION=go$(/tmp/go-version.sh /tmp/go.mod) && \
    case "$ARCH" in \
      amd64) GO_SHA256="$GO_SHA256_amd64" ;; \
      arm64) GO_SHA256="$GO_SHA256_arm64" ;; \
      *) echo "no pinned Go checksum for $ARCH" >&2; exit 1 ;; \
    esac && \
    curl --proto '=https' --tlsv1.2 -sSfL "https://go.dev/dl/${GO_VERSION}.linux-${ARCH}.tar.gz" -o /tmp/go.tar.gz && \
    { echo "${GO_SHA256}  /tmp/go.tar.gz" | sha256sum --check || \
      { echo "${GO_VERSION}.linux-${ARCH}.tar.gz does not match the pinned checksum, update the golang-sha256 entries of dependencies.yaml" >&2; exit 1; }; } && \
    tar -xzf /tmp/go.tar.gz -C /usr/local && \
    rm -f /tmp/go.tar.gz /tmp/go.mod /tmp/go-version.sh
ENV PATH="/usr/local/go/bin:$PATH"

COPY . /work
RUN mkdir -p build

ARG APPARMOR_ENABLED=0
ARG BPF_ENABLED=0

# OCP in FIPS mode doesn't like statically linked SPO
ARG STATIC_LINK=no

# The build date embedded in the binaries, hack/image-cross.sh passes the
# commit time so that the same commit gives the same binaries.
ARG SOURCE_DATE_EPOCH

RUN make

# Dependabot keeps the digest up to date.
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:6f3a78179e0b30b930a186e7f68a4af52e51bb82406c9653be10bddd624e40f5
ARG version
# The OCI image annotations, see Dockerfile.
ARG source=https://github.com/kubernetes-sigs/security-profiles-operator
ARG revision
ARG created
USER root

# Update all packages of the base image, since the vulnerability scan fails on
# any fixed package the base image does not include yet. The image job of
# .github/workflows/build.yml sets UBI_REPOS_REVISION to the revisions of the
# UBI 9 repositories, which invalidates the cached update when new errata land.
# The job fails without this ARG or on another base image, keep the ARG name
# and the repository URL of the job in sync.
ARG UBI_REPOS_REVISION
RUN microdnf update -y \
  && microdnf install -y \
  libseccomp \
  && microdnf clean all

LABEL name="Security Profiles Operator" \
  version=$version \
  description="The Security Profiles Operator makes it easier for cluster admins to manage their SELinux, seccomp and AppArmor profiles and apply them to Kubernetes' workloads." \
  org.opencontainers.image.title="Security Profiles Operator" \
  org.opencontainers.image.description="The Security Profiles Operator makes it easier for cluster admins to manage their SELinux, seccomp and AppArmor profiles and apply them to Kubernetes' workloads." \
  org.opencontainers.image.source=$source \
  org.opencontainers.image.revision=$revision \
  org.opencontainers.image.version=$version \
  org.opencontainers.image.created=$created \
  org.opencontainers.image.licenses="Apache-2.0"

COPY --from=build /work/build/security-profiles-operator /usr/bin/
COPY --from=build /work/build/spoc /usr/bin/

USER 65535:65535

ENTRYPOINT ["/usr/bin/security-profiles-operator"]

# vim: ft=dockerfile
