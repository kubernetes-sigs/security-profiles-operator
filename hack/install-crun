#!/usr/bin/env bash
set -euox pipefail

# shellcheck source=hack/lib/common.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/common.sh"

CRUN_VERSION=1.31
# Bump together with CRUN_VERSION, see dependencies.yaml.
CRUN_SHA256_amd64=8cacae171bb0e5f9e275adac2eeb2c6ec8c69fdedff7b008eadd8cdd25b0d349
CRUN_SHA256_arm64=f54fd58603ae031aa7a255af550bcffb035f28058aa1a971e6691b53f7f5a32e
CRUN_BIN=/tmp/crun

case "$(uname -m)" in
x86_64) ARCH=amd64 CRUN_SHA256=$CRUN_SHA256_amd64 ;;
aarch64) ARCH=arm64 CRUN_SHA256=$CRUN_SHA256_arm64 ;;
*)
    echo "Unsupported architecture $(uname -m)" >&2
    exit 1
    ;;
esac

# Current crun version
crun --version

# Download
download_verified \
    "https://github.com/containers/crun/releases/download/$CRUN_VERSION/crun-$CRUN_VERSION-linux-$ARCH" \
    "$CRUN_SHA256" "$CRUN_BIN"
chmod +x "$CRUN_BIN"

# Override current crun
sudo mv "$CRUN_BIN" "$(command -v crun)"
crun --version
