# Dependabot keeps the tag and the digest up to date.
FROM registry.k8s.io/build-image/debian-base:bookworm-v1.0.9@sha256:628de94e72732b63ddd84a79f961ef1045779bb83edd170e8306f4ba28a511e4
WORKDIR /work

# The builds run in nix, which brings the libraries the binaries link
# against, so only the tools for installing nix are needed.
RUN apt-get update && \
  apt-get install -y --no-install-recommends ca-certificates wget xz-utils && \
  apt-get autoremove  -y && \
  apt-get purge -y --auto-remove && \
  rm -rf /var/lib/apt/lists/*

ENV USER=root

ARG NIX_VERSION=2.35.3

# Checksum of nix-${NIX_VERSION}-x86_64-linux.tar.xz. Every other tool this
# repo downloads is checksum verified, so nix must not be the one unverified
# binary input in the build chain.
ARG NIX_SHA256=6ce3ce3703fdc241b560cba401c5d338042122fe5b1a81e07bf1a623f259eba0

# The image only runs on amd64: Dockerfile uses it on the build platform and
# cross compiles the binaries of the other architectures with nix.
RUN \
  export ARCH=x86_64 && \
  wget https://nixos.org/releases/nix/nix-${NIX_VERSION}/nix-${NIX_VERSION}-${ARCH}-linux.tar.xz && \
  printf '%s  %s\n' "${NIX_SHA256}" "nix-${NIX_VERSION}-${ARCH}-linux.tar.xz" > nix-${NIX_VERSION}.sha256 && \
  sha256sum --check nix-${NIX_VERSION}.sha256 && \
  tar xf nix-${NIX_VERSION}-${ARCH}-linux.tar.xz && \
  groupadd -r -g 30000 nixbld && \
  for i in $(seq 1 30); do useradd -rlM -u $((30000 + i)) -G nixbld "nixbld$i" ; done && \
  mkdir -m 0755 /etc/nix /nix && \
  printf "sandbox = false\nfilter-syscalls = false\nexperimental-features = nix-command flakes\n" > /etc/nix/nix.conf && \
  nix-${NIX_VERSION}-${ARCH}-linux/install && \
  ln -s /nix/var/nix/profiles/default/etc/profile.d/nix.sh /etc/profile.d && \
  rm -rf nix-*

ENV ENV=/etc/profile \
  PATH=/nix/var/nix/profiles/default/bin:/nix/var/nix/profiles/default/sbin:/bin:/sbin:/usr/bin:/usr/sbin \
  GIT_SSL_CAINFO=/etc/ssl/certs/ca-certificates.crt \
  NIX_SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
  NIX_PATH=/nix/var/nix/profiles/per-user/root/channels

# Only the dependencies of the released binaries are cached in the image, the
# binaries themselves are always built from source in the image build (see
# Dockerfile). Everything comes from cache.nixos.org or is built here, never
# from the project's Cachix cache: CI jobs which run repository code write to
# that one, so it must not be able to reach the released toolchain. Pull
# requests, which only check that the image builds, can set CACHIX to the
# cache name to save the time.
ARG CACHIX=
COPY . /build
RUN if [ -n "$CACHIX" ]; then \
    nix-env -i "$(nix build --inputs-from path:/build nixpkgs#cachix --no-link --print-out-paths)" && \
    cachix use "$CACHIX"; \
  fi && \
  nix build --no-link \
    path:/build#spo-amd64.inputDerivation \
    path:/build#spo-arm64.inputDerivation \
    path:/build#spo-ppc64le.inputDerivation && \
  rm -rf /build && \
  nix-store --optimise && \
  nix-store --verify --check-contents

# vim: ft=dockerfile
